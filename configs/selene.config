# HakiOS fragment: the Redmi 10 family (selene / selenes / eos, MT6769H / Helio G88).
# 1080 x 2400 panel (NT36672C, LK fb 0x7e605000) shown at scale 2 (fbscale=2 fbfit=3).
# Touch controller is Novatek NT36672C on SPI0 (0x1100a000, cs 0, 9.6 MHz, reset GPIO 92, irq GPIO 1).
# Keypad at 0x10010000 and MT6358 PMIC (PWRAP 0x1000d000) for power key.
# Cortex-A75 big cores at 2000 MHz.
CONFIG_DEVICE="selene"
CONFIG_HAKIOS_NOVATEK=y
CONFIG_BUTTONS=2
CONFIG_MTK_CPUFREQ=3
CONFIG_MALI=y
CONFIG_MALI_MHZ=800
CONFIG_FBSCALE=2
CONFIG_FBFIT=3
CONFIG_FB_QUEUE=1
CONFIG_FB_FLIP=y
CONFIG_FB_INUSE=y
CONFIG_SURF_ALIGN=y
CONFIG_SURF_LOCKWAIT=y
CONFIG_SCP_STEP=7
CONFIG_BOOTARGS="touchscreen=3"
